PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Filled in automatically by `npm install` (scripts/setup.js). Use at least 32 random characters.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# MongoDB Atlas. Leave MONGODB_URI commented out to run with in-memory demo data.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/sports_team_portal
MONGODB_DB_NAME=sports_team_portal
